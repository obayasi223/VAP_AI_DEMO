{
  "$schema": "../packages/contracts/schemas/policy.ja.schema.json",
  "policy_id": "ja",
  "immutable": false,
  "status": "template",
  "note": "Template. turn.constants start as a copy of the HRI 2025 values and are uncalibrated for Japanese. null means uncalibrated: do not silently replace it. Owners: turn/gaze E, similarity/completion D, initiative G. vap direction is provisional until R2 measures it. turn.constants.TURNGPT_PREPARE_THRESHOLD and SIMILARITY_PREPARE_THRESHOLD are not read for ja: the source of truth is completion.thresholds and similarity.threshold (docs/known_gaps.md). initiative.trigger values are unverified provisional. turn.start_guard and turn.after_ai_speech are not in HRI 2025: provisional, based only on one real session (s20261108T045055-ca6e12, docs/known_gaps.md section 10). turn.vap_unavailable is not in HRI 2025: provisional, docs/known_gaps.md section 12. turn.outcome is an observation-only classification (never used for the decision): provisional, docs/known_gaps.md section 14. initiative.negotiation.vocal_cue values are uncalibrated provisional (no measurements; only used when vocal_cue is not none; docs/initiative_v3_design.md section 10).",
  "vap": {
    "channel_layout": "2ch",
    "p_ai_index": 1,
    "direction_status": "measured",
    "speaking_threshold": 0.5
  },
  "turn": {
    "constants": {
      "TURNGPT_PREPARE_THRESHOLD": 0.2,
      "ASR_PREPARE_TIMEOUT_MS": 200,
      "SIMILARITY_PREPARE_THRESHOLD": 0.8,
      "VAP_PNOW_INTERRUPT": 0.4,
      "VAP_PFUT_INTERRUPT": 0.4,
      "VAP_PNOW_YIELD": 0.5,
      "VAP_PFUT_YIELD": 0.5,
      "MIN_GAP_TIME_MS": 500,
      "YIELD_TIMEOUTS_MS": {
        "0.3": 500,
        "0.2": 1000,
        "0.1": 2000,
        "0.0": 3000
      }
    },
    "interpretation": {
      "user_turn_end_updates_during_speech": true,
      "stop_point": "word_boundary",
      "apply_u_corrections": true
    },
    "tick_ms": 20,
    "stop_boundary_max_ms": 200,
    "vap_stale_ms": 500,
    "vap_rewarm_ms": 10000,
    "fallback_silence_max_ms": 1500,
    "fallback_interrupt_min_words": 3,
    "fallback_energy_silence_dbfs": -45,
    "user_speaking_min_ms": null,
    "start_guard": {
      "min_gap_ms": 900,
      "completion_timeout_min_p_ai": 0.5,
      "completion_timeout_low_p_min_ms": 1500
    },
    "vap_unavailable": {
      "asr_quiet_after_final_ms": 300,
      "asr_quiet_without_final_ms": 1200,
      "interrupt_asr_recent_ms": 1000,
      "ai_reference_missing_ms": null
    },
    "after_ai_speech": {
      "rebase_user_end_times": true,
      "fragment_max_chars": 4,
      "backchannel_phrases": [
        "うん", "ううん", "はい", "ええ", "えー", "ああ", "あー", "あ", "おお", "おー", "へえ", "へー", "ほう", "ほー", "ふーん", "ふうん",
        "なるほど", "そう", "そうか", "そっか", "そうです", "そうですね", "そうですか", "そうなんだ", "そうなんですね", "そうなんですか",
        "たしかに", "確かに", "ですね", "ですよね", "ね", "ねえ", "まあ"
      ]
    },
    "outcome": {
      "continuation_window_ms": 1500,
      "settle_ms": 1000,
      "user_just_before_ms": 1500,
      "premature_onset_max_ms": 800,
      "overlap_min_ms": 240,
      "interrupted_early_max_ms": 2000,
      "no_response_wait_ms": 4000,
      "echo_text_similarity": 0.6,
      "echo_overlap_ratio": 0.7
    }
  },
  "gaze": {
    "pause_min_ms": 200,
    "signal": "p_now",
    "p_threshold": 0.5,
    "hold_away_min_ms": 600,
    "re_avert_min_ms": 1000
  },
  "similarity": {
    "method": "char_ngram_cosine",
    "threshold": 0.9
  },
  "completion": {
    "estimator": "ja_rules_v1",
    "thresholds": {
      "ja_rules_v1": { "prepare_threshold": 0.3 },
      "llm_completion_v1": { "prepare_threshold": null }
    }
  },
  "initiative": {
    "max_new_stable_chars_since_input": 60,
    "max_result_age_ms": 8000,
    "min_stability": 0.8,
    "stable_prefix_revisions": 3,
    "stable_prefix_min_age_ms": 300,
    "candidate_expiry_ms": 15000,
    "candidate_expires_on_segment_change": null,
    "signal_cooldown_ms": 4000,
    "max_active_candidates": 1,
    "max_requests_per_session": 200,
    "trigger": {
      "min_new_stable_chars": 24,
      "min_new_chars_at_boundary": 12
    },
    "negotiation": {
      "inhale_ms": 700,
      "hold_max_ms": 800,
      "max_new_stable_chars_since_judgement": null,
      "cue_max_judgement_age_ms": null,
      "cue_reaction_window_ms": 2000,
      "vocal_cue": {
        "min_user_silence_ms": 300,
        "min_asr_quiet_ms": 200,
        "max_vad_user": 0.5,
        "pre_beginning_phrase": "あ、",
        "observation_window_ms": 2000
      }
    },
    "staged": {
      "timing_strategy": "llm",
      "conversation_kind": "joint_thinking",
      "desire_prompt_version": "initiative-desire-ja-v4",
      "timing_prompt_version": "initiative-timing-ja-v2",
      "recent_context": { "max_turns": 6, "max_chars_per_turn": 300 },
      "revise_min_utterance_similarity": 0.8,
      "already_said_min_similarity": 0.8,
      "reflection_min_containment": 0.5
    }
  },
  "speech": {
    "is_ready_buffer_ms": 200
  }
}
