{
  "config_id": "two_ai_session_ja",
  "version": 2,
  "self_run": false,
  "phases": {
    "intake": {
      "min_sec": 180,
      "soft_sec": 240,
      "max_sec": 300,
      "plan_start_sec": 200
    },
    "plan_wait": {
      "filler_after_ms": 0,
      "second_filler_after_ms": 12000,
      "max_wait_ms": 37000,
      "on_timeout": "pause_for_woz"
    },
    "discussion": {
      "target_sec": 540,
      "close_at_sec": 480,
      "max_sec": 600,
      "points_overrun_max_sec": 60,
      "interjection_allowance_max_sec": 240,
      "avg_turn_sec_estimate": 9,
      "closing_reserve_sec": 30,
      "chars_per_sec_estimate": 7,
      "stage_fracs": [
        0.25,
        0.25,
        0.25,
        0.25
      ]
    },
    "response": {
      "duration_sec": 120,
      "overrun_max_sec": 10,
      "silence_prompt_sec": 20,
      "max_silence_prompts": 2
    },
    "next_step": {
      "pick_max_sec": 60
    }
  },
  "speakers": {
    "intake": "A",
    "next_step": "A",
    "closing": "A"
  },
  "gaps_ms": {
    "default": {
      "median": 600,
      "min": 300,
      "max": 1200
    },
    "react": {
      "median": 400,
      "min": 200,
      "max": 900
    },
    "after_point": {
      "median": 900,
      "min": 500,
      "max": 1500
    },
    "resume_gap_ms": 400,
    "max_wait_for_ready_ms": 1500,
    "feed_turn_max_wait_ms": 4000
  },
  "interjection": {
    "detector": {
      "vad_threshold": null,
      "p_now_user_min": null,
      "p_future_user_min": null,
      "p_combine": "and",
      "onset_min_ms": 200,
      "refractory_ms": 1000,
      "fallback_dbfs": -35,
      "fallback_onset_min_ms": 400,
      "sub_threshold_min_ms": 100
    },
    "stop_max_wait_ms": null,
    "user_floor_max_ms": 60000,
    "false_onset_window_ms": 1500,
    "classify": {
      "backchannel_max_voiced_ms": 700,
      "backchannel_max_chars": 6
    }
  },
  "marker": {
    "enabled": true,
    "min_interval_ms": 1000,
    "near_window_ms": 500
  },
  "retraction": {
    "timing": "after_measures",
    "template": {
      "fact": "先ほど「{slip_statement}」と言いましたが、正しくは「{correct_statement}」でした。",
      "inference": "そのうえで「{inference_steps}」という話をしましたが、その推論は誤った前提の上にありました。「{inference_conclusion}」という結論は取り消します。",
      "inference_unspoken": "そのうえで「{inference_steps}」という話をする予定でしたが、その推論は誤った前提の上にありました。「{inference_conclusion}」という結論は取り消します。",
      "process": "この話し合いでは、研究のために、AI が事実を取り違える場面をあらかじめ入れていました。"
    },
    "speaker": "B"
  },
  "acknowledgment": {
    "templates": [
      {
        "id": "ack_1",
        "text": "なるほど、そう思われるんですね。"
      }
    ],
    "selection": "fixed_first",
    "duration_tolerance_ms": 150,
    "speaker": "interrupted_ai"
  },
  "fixed": {
    "bridge": "話を戻すと、",
    "hold_bridge": "少し先に進めますね。",
    "lines": {
      "opening_two": "ここからは、わたしたち二人で、お話の内容について話し合ってみます。",
      "opening_cond": {
        "respond_on_spot": "途中で気になったことがあれば、いつでも口を挟んでください。",
        "respond_at_end": "最後にまとめてお話を伺う時間をとりますので、まずは聞いていてください。"
      },
      "plan_fillers": [
        "少し考えをまとめますね。",
        "もう少しだけお待ちください。"
      ],
      "closing_two": "わたしたちの話し合いは、ここまでにします。",
      "closing_question": "途中で、何か言いたくなったところがありそうですか。",
      "response_more": "ほかにも何かあれば、どうぞ。",
      "intake_first_question": "今日はどんなことについて話したいですか。",
      "intake_fact_questions": [
        "締切や日程で、もう決まっていることはありますか。",
        "ほかに、数字や場所で決まっていることはありますか。"
      ],
      "core_readback": "いちばん引っかかっているのは、{core}ということでしょうか。",
      "core_readback_no_core": "いちばん引っかかっているのは、どのあたりですか。",
      "pick_prompt": "この中から、次の一歩を一枚選んでください。",
      "pick_confirm": "ありがとうございます。",
      "pick_timeout": "今日はここまでにしましょう。"
    },
    "stage_headings": [
      "いまの状況の整理",
      "二人の見方",
      "もう一歩の掘り下げ",
      "次の一歩の候補"
    ],
    "instruction_keys": {
      "intake": "intake",
      "discussion": {
        "respond_on_spot": "discussion_a",
        "respond_at_end": "discussion_b"
      },
      "response": "response",
      "next_step": "next_step",
      "end": "end"
    }
  },
  "correction": {
    "assist": true,
    "mode": "researcher",
    "decision_window_ms": 2500,
    "hold_max_ms": 6000
  },
  "experience": {
    "interjection_feeds_generation": false,
    "response_mode": "fixed",
    "feed": {
      "max_items": 3,
      "max_chars": 200
    }
  },
  "generation": {
    "models": {
      "intake": "gemini-3.5-flash-lite",
      "ledger": "gemini-3.5-flash-lite",
      "discussion_plan": "gemini-3.8-flash",
      "discussion_turn": "gemini-3.5-flash-lite",
      "correction_assist": "gemini-3.5-flash-lite"
    },
    "lookahead_turns": 2,
    "history_turns": 12,
    "timeout_ms": {
      "discussion_turn": 8000,
      "discussion_plan": 45000,
      "ledger": 10000,
      "correction_assist": 5000
    },
    "max_output_tokens": {
      "discussion_plan": 16384
    }
  },
  "safety": {
    "banned_terms_file": "config/two_ai/banned_terms.ja.txt",
    "person_evaluation_pairs_file": "config/two_ai/person_evaluation_pairs.ja.json"
  },
  "render": {
    "max_fps": 30,
    "pixel_ratio_max": 1.5,
    "spring_bones": "speaker_only"
  }
}
