# Copy to .env and fill in your own values. Never commit .env.
# 実 API の仕様は docs/implementation_plan.md §1.1 のとおり一部未確認（R4 で確認）。

# --- Gemini（旧デモの server.mjs も同じ変数を読む） ---
# The key is used only on the local Node.js server (not sent to the browser).
# 参加者の発話を送るなら有料ティアのキーを使う（docs/provider_matrix.md §1 の #8）。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- 旧デモ（server.mjs）のポート ---
PORT=3977

# --- プロバイダの切替（production / development / test_double） ---
# development と test_double のセッションは受け入れの証拠に数えない（計画 §4.8）。
STT_PROVIDER_CLASS=production
TTS_PROVIDER_CLASS=production
LLM_PROVIDER_CLASS=production

# --- Google Cloud Speech-to-Text v2 ---
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
# 既定は R4 の実測による。候補は docs/provider_matrix.md。
GOOGLE_STT_LOCATION=asia-northeast1
GOOGLE_STT_MODEL=long
# 1 で gcloud の既定認証（ADC）を明示して使う。GOOGLE_APPLICATION_CREDENTIALS の代わり。
GOOGLE_STT_USE_ADC=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# PCM の形式は環境変数でなく TtsProvider.open() の preferred_sample_rate_hz で決まる。
# 実測: pcm_16000 と pcm_24000 は通る。pcm_44100 は Pro 以上でないと拒否される。

# --- TTS の切替 ---
# auto: ElevenLabs のキーと声 ID が両方あれば ElevenLabs、なければ Gemini TTS。elevenlabs、gemini で固定できる。
TTS_PROVIDER=auto
# Gemini TTS（代替）。キーは GEMINI_API_KEY。語時刻は推定で、実測の時刻ではない。
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore

# --- 読み（形態素解析 kuromoji。apps/orchestrator/src/speech/reading/） ---
# 口形の読み: playback.alignment の語に推定の読み（カタカナ）を付け、漢字の語も母音の口形にする。既定 1。
LIPSYNC_READING=1
# TTS へ送る文の読みの変換。off（既定）／risky（固有名詞・数詞＋助数詞・漢字1〜2字の名詞だけひらがな）／all（漢字と数を全部ひらがな）。
# 履歴・字幕・spoken_text は元の漢字の文のまま。STT 往復の実験（tools/provider_probe/README.md の reading_tts）で
# risky は読み誤りの疑いを減らしたが、人の耳での確認が済むまで既定は off。
TTS_READING_MODE=off

# --- Orchestrator / Web ---
ORCHESTRATOR_PORT=8787
NEXT_PUBLIC_ORCHESTRATOR_WS_URL=ws://localhost:8787/ws
POLICY_FILE=config/policy.ja.json
# 研究条件（reactive / initiative_no_cue / initiative_inhale）
CONDITION=reactive

# --- 発話希望の判定（InitiativeMonitor、波2） ---
# 動かす条件をカンマ区切りで。空なら3条件とも（ja の方策のとき）。none で止める。
# 波2では候補を作って記録と研究者画面に出すだけで、発声と吸気には使わない。
INITIATIVE_CONDITIONS=
# 判定のモデル（思考はモデルごとの下限。flash-lite は minimal）。応答の GEMINI_MODEL とは別。
INITIATIVE_GEMINI_MODEL=gemini-3.5-flash-lite
PERSONA_FILE=config/persona.ja.json

# --- MaAI ワーカー（Node↔Python は localhost の WS） ---
MAAI_WORKER_URL=ws://127.0.0.1:8788
# 既定は計画 §9-1 の推奨（回答待ち）。jp は CC-BY-NC-ND 4.0 なので区分を確認してから使う。
MAAI_LANG=jp_kyoto
MAAI_MODEL_TYPE=normal-ver2
MAAI_FRAME_RATE_HZ=12.5
MAAI_DEVICE=cpu

# --- 偽サーバー（npm run dev:fakes）。本番の検証には数えない ---
FAKE_BROWSER_ECHO_PORT=9101
FAKE_MAAI_PORT=9102
FAKE_ELEVENLABS_PORT=9103
FAKE_GEMINI_PORT=9104
