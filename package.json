{
  "name": "breath-intent-avatar-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Research prototype: LLM-originated speech intention expressed through a visible inhalation motion",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:ts",
    "gen:schemas": "npm run gen:schemas -w @llm-vap/contracts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run typecheck && npm run build -w @llm-vap/web",
    "test:ts": "vitest run",
    "test:py": ".venv/bin/python -m pytest workers/maai/tests -q",
    "test:all": "npm run typecheck && npm run test:ts && npm run test:py",
    "dev:web": "npm run dev -w @llm-vap/web",
    "dev:orchestrator": "tsx apps/orchestrator/src/main.ts",
    "dev:tune": "tsx apps/orchestrator/src/dev/main.ts",
    "dev:orchestrator:scripted": "STT_PROVIDER_CLASS=test_double TTS_PROVIDER_CLASS=test_double LLM_PROVIDER_CLASS=test_double tsx apps/orchestrator/src/main.ts",
    "test:e2e": "tsx apps/orchestrator/test/e2e/run.ts",
    "log:check": "tsx tools/log_check/cli.ts",
    "dev:fakes": "npm run fakes -w @llm-vap/testkit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
