{
  "$id": "maai_rpc.node_to_worker.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "CONFIGURE"
        },
        "protocol_version": {
          "type": "number",
          "const": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "type": "string",
          "enum": [
            "jp",
            "jp_kyoto"
          ]
        },
        "model_type": {
          "type": "string",
          "enum": [
            "normal",
            "normal-ver2"
          ]
        },
        "channel_layout": {
          "type": "string",
          "enum": [
            "1ch",
            "2ch"
          ]
        },
        "frame_rate_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sample_rate_hz": {
          "type": "number",
          "const": 16000
        },
        "frame_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "device": {
          "type": "string",
          "const": "cpu"
        },
        "speaking_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "type",
        "protocol_version",
        "session_id",
        "lang",
        "model_type",
        "channel_layout",
        "frame_rate_hz",
        "sample_rate_hz",
        "frame_samples",
        "device",
        "speaking_threshold"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "SHUTDOWN"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "PING"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "t_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "seq",
        "t_ms"
      ],
      "additionalProperties": false
    }
  ]
}
