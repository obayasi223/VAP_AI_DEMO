{
  "$id": "policy.ja.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "policy_id": {
      "type": "string",
      "const": "ja"
    },
    "immutable": {
      "type": "boolean",
      "const": false
    },
    "status": {
      "type": "string",
      "enum": [
        "template",
        "provisional",
        "calibrated"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "vap": {
      "type": "object",
      "properties": {
        "channel_layout": {
          "type": "string",
          "const": "2ch"
        },
        "p_ai_index": {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 1
            }
          ]
        },
        "direction_status": {
          "type": "string",
          "enum": [
            "provisional",
            "measured"
          ]
        },
        "speaking_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "channel_layout",
        "p_ai_index",
        "direction_status",
        "speaking_threshold"
      ],
      "additionalProperties": false
    },
    "turn": {
      "type": "object",
      "properties": {
        "constants": {
          "type": "object",
          "properties": {
            "TURNGPT_PREPARE_THRESHOLD": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ASR_PREPARE_TIMEOUT_MS": {
              "type": "number",
              "minimum": 0
            },
            "SIMILARITY_PREPARE_THRESHOLD": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "VAP_PNOW_INTERRUPT": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "VAP_PFUT_INTERRUPT": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "VAP_PNOW_YIELD": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "VAP_PFUT_YIELD": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "MIN_GAP_TIME_MS": {
              "type": "number",
              "minimum": 0
            },
            "YIELD_TIMEOUTS_MS": {
              "type": "object",
              "properties": {
                "0.3": {
                  "type": "number",
                  "minimum": 0
                },
                "0.2": {
                  "type": "number",
                  "minimum": 0
                },
                "0.1": {
                  "type": "number",
                  "minimum": 0
                },
                "0.0": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "0.3",
                "0.2",
                "0.1",
                "0.0"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "TURNGPT_PREPARE_THRESHOLD",
            "ASR_PREPARE_TIMEOUT_MS",
            "SIMILARITY_PREPARE_THRESHOLD",
            "VAP_PNOW_INTERRUPT",
            "VAP_PFUT_INTERRUPT",
            "VAP_PNOW_YIELD",
            "VAP_PFUT_YIELD",
            "MIN_GAP_TIME_MS",
            "YIELD_TIMEOUTS_MS"
          ],
          "additionalProperties": false
        },
        "interpretation": {
          "type": "object",
          "properties": {
            "user_turn_end_updates_during_speech": {
              "type": "boolean"
            },
            "stop_point": {
              "type": "string",
              "enum": [
                "word_boundary",
                "immediate"
              ]
            },
            "apply_u_corrections": {
              "type": "boolean"
            }
          },
          "required": [
            "user_turn_end_updates_during_speech",
            "stop_point",
            "apply_u_corrections"
          ],
          "additionalProperties": false
        },
        "tick_ms": {
          "type": "number",
          "minimum": 1
        },
        "stop_boundary_max_ms": {
          "type": "number",
          "minimum": 0
        },
        "vap_stale_ms": {
          "type": "number",
          "minimum": 0
        },
        "vap_rewarm_ms": {
          "type": "number",
          "minimum": 0
        },
        "user_speaking_min_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback_silence_max_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback_interrupt_min_words": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback_energy_silence_dbfs": {
          "anyOf": [
            {
              "type": "number",
              "maximum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "start_guard": {
          "type": "object",
          "properties": {
            "min_gap_ms": {
              "type": "number",
              "minimum": 0
            },
            "completion_timeout_min_p_ai": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "completion_timeout_low_p_min_ms": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "min_gap_ms",
            "completion_timeout_min_p_ai",
            "completion_timeout_low_p_min_ms"
          ],
          "additionalProperties": false
        },
        "after_ai_speech": {
          "type": "object",
          "properties": {
            "rebase_user_end_times": {
              "type": "boolean"
            },
            "fragment_max_chars": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "backchannel_phrases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "rebase_user_end_times",
            "fragment_max_chars",
            "backchannel_phrases"
          ],
          "additionalProperties": false
        },
        "vap_unavailable": {
          "type": "object",
          "properties": {
            "asr_quiet_after_final_ms": {
              "type": "number",
              "minimum": 0
            },
            "asr_quiet_without_final_ms": {
              "type": "number",
              "minimum": 0
            },
            "interrupt_asr_recent_ms": {
              "type": "number",
              "minimum": 0
            },
            "ai_reference_missing_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "asr_quiet_after_final_ms",
            "asr_quiet_without_final_ms",
            "interrupt_asr_recent_ms",
            "ai_reference_missing_ms"
          ],
          "additionalProperties": false
        },
        "outcome": {
          "type": "object",
          "properties": {
            "continuation_window_ms": {
              "type": "number",
              "minimum": 0
            },
            "settle_ms": {
              "type": "number",
              "minimum": 0
            },
            "user_just_before_ms": {
              "type": "number",
              "minimum": 0
            },
            "premature_onset_max_ms": {
              "type": "number",
              "minimum": 0
            },
            "overlap_min_ms": {
              "type": "number",
              "minimum": 0
            },
            "interrupted_early_max_ms": {
              "type": "number",
              "minimum": 0
            },
            "no_response_wait_ms": {
              "type": "number",
              "minimum": 0
            },
            "echo_text_similarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "echo_overlap_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "continuation_window_ms",
            "settle_ms",
            "user_just_before_ms",
            "premature_onset_max_ms",
            "overlap_min_ms",
            "interrupted_early_max_ms",
            "no_response_wait_ms",
            "echo_text_similarity",
            "echo_overlap_ratio"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "constants",
        "interpretation",
        "tick_ms",
        "stop_boundary_max_ms",
        "vap_stale_ms",
        "vap_rewarm_ms",
        "user_speaking_min_ms",
        "fallback_silence_max_ms",
        "fallback_interrupt_min_words"
      ],
      "additionalProperties": false
    },
    "gaze": {
      "type": "object",
      "properties": {
        "pause_min_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "p_now",
                "p_future"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "p_threshold": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "hold_away_min_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "re_avert_min_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pause_min_ms",
        "signal",
        "p_threshold"
      ],
      "additionalProperties": false
    },
    "similarity": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "method",
        "threshold"
      ],
      "additionalProperties": false
    },
    "completion": {
      "type": "object",
      "properties": {
        "estimator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "thresholds": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "prepare_threshold": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "prepare_threshold"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "estimator",
        "thresholds"
      ],
      "additionalProperties": false
    },
    "initiative": {
      "type": "object",
      "properties": {
        "max_new_stable_chars_since_input": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "max_result_age_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "min_stability": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "stable_prefix_revisions": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "stable_prefix_min_age_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_expiry_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_expires_on_segment_change": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "signal_cooldown_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_active_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_requests_per_session": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "trigger": {
          "type": "object",
          "properties": {
            "min_new_stable_chars": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "min_new_chars_at_boundary": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "min_new_stable_chars",
            "min_new_chars_at_boundary"
          ],
          "additionalProperties": false
        },
        "negotiation": {
          "type": "object",
          "properties": {
            "inhale_ms": {
              "type": "integer",
              "minimum": 200,
              "maximum": 1400
            },
            "hold_max_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max_new_stable_chars_since_judgement": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "cue_max_judgement_age_ms": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "cue_reaction_window_ms": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "inhale_ms",
            "hold_max_ms",
            "max_new_stable_chars_since_judgement",
            "cue_max_judgement_age_ms"
          ],
          "additionalProperties": false
        },
        "staged": {
          "type": "object",
          "properties": {
            "timing_strategy": {
              "type": "string",
              "enum": [
                "llm",
                "immediate",
                "v2"
              ]
            },
            "conversation_kind": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "desire_prompt_version": {
              "type": "string",
              "minLength": 1
            },
            "timing_prompt_version": {
              "type": "string",
              "minLength": 1
            },
            "recent_context": {
              "type": "object",
              "properties": {
                "max_turns": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "max_chars_per_turn": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "max_turns",
                "max_chars_per_turn"
              ],
              "additionalProperties": false
            },
            "revise_min_utterance_similarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "already_said_min_similarity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reflection_min_containment": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "timing_strategy",
            "conversation_kind",
            "desire_prompt_version",
            "timing_prompt_version",
            "recent_context"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "max_new_stable_chars_since_input",
        "max_result_age_ms",
        "min_stability",
        "stable_prefix_revisions",
        "stable_prefix_min_age_ms",
        "candidate_expiry_ms",
        "candidate_expires_on_segment_change",
        "signal_cooldown_ms",
        "max_active_candidates",
        "max_requests_per_session"
      ],
      "additionalProperties": false
    },
    "speech": {
      "type": "object",
      "properties": {
        "is_ready_buffer_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "is_ready_buffer_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "policy_id",
    "immutable",
    "status",
    "note",
    "vap",
    "turn",
    "gaze",
    "similarity",
    "completion",
    "initiative",
    "speech"
  ],
  "additionalProperties": false
}
