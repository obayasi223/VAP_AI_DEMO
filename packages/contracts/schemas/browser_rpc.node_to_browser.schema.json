{
  "$id": "browser_rpc.node_to_browser.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "server.hello"
        },
        "protocol_version": {
          "type": "number",
          "const": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "enum": [
            "reactive",
            "initiative_no_cue",
            "initiative_inhale"
          ]
        },
        "is_fake": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "protocol_version",
        "session_id",
        "condition",
        "is_fake"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "clock.pong"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "client_t_ms": {
          "type": "number",
          "minimum": 0
        },
        "server_t_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "seq",
        "client_t_ms",
        "server_t_ms"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "playback.begin"
        },
        "audio_playback_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "sample_rate_hz": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "audio_playback_id",
        "generation",
        "sample_rate_hz"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "playback.stop"
        },
        "audio_playback_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "stop": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "immediate"
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "fade"
                },
                "fade_ms": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "mode",
                "fade_ms"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "at_sample"
                },
                "stop_at_sample": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "fade_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "deadline_ms": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "mode",
                "stop_at_sample",
                "fade_ms",
                "deadline_ms"
              ],
              "additionalProperties": false
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "audio_playback_id",
        "generation",
        "stop",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "playback.alignment"
        },
        "audio_playback_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "start_ms": {
                "type": "number",
                "minimum": 0
              },
              "end_ms": {
                "type": "number",
                "minimum": 0
              },
              "granularity": {
                "type": "string",
                "enum": [
                  "word",
                  "char"
                ]
              },
              "reading": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "text",
              "start_ms",
              "end_ms",
              "granularity"
            ],
            "additionalProperties": false
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "provider_char",
            "estimated_time_proportional"
          ]
        },
        "reading_source": {
          "type": "string",
          "enum": [
            "morphological_estimate"
          ]
        }
      },
      "required": [
        "type",
        "audio_playback_id",
        "generation",
        "items"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "signal.command"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "enum": [
            "inhale",
            "ready",
            "relax",
            "pre_speech"
          ]
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "number",
              "boolean",
              "string"
            ]
          }
        }
      },
      "required": [
        "type",
        "candidate_id",
        "phase",
        "parameters"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "gaze.command"
        },
        "target": {
          "type": "string",
          "enum": [
            "user",
            "away"
          ]
        }
      },
      "required": [
        "type",
        "target"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "session.status"
        },
        "degraded": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "type",
        "degraded",
        "reasons"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "breath.cue"
        },
        "cue_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "cue_id",
        "candidate_id",
        "duration_ms"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "breath.release"
        },
        "cue_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "enum": [
            "speech_started",
            "deferred",
            "withdrawn"
          ]
        }
      },
      "required": [
        "type",
        "cue_id",
        "candidate_id",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "breath.prepare"
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "candidate_id"
      ],
      "additionalProperties": false
    }
  ]
}
